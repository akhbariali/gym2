[Unit]
Description=WHEY CLUB isolated static storefront on port 8088
After=network.target

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=whey-club
ExecStart=/usr/sbin/nginx -p /opt/whey-club/ -c /opt/whey-club/nginx.conf -g "daemon off;"
Restart=on-failure
RestartSec=5
KillSignal=SIGQUIT
TimeoutStopSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=64M
CPUQuota=20%
TasksMax=16

[Install]
WantedBy=multi-user.target
